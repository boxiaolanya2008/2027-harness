#!/bin/sh
# 每次提交自动追加 AI 共创者尾注，已有的跳过
COMMIT_MSG_FILE=$1

add_coauthor() {
	name=$1
	email=$2
	grep -qi "^Co-authored-by: $name " "$COMMIT_MSG_FILE" && return
	printf "\nCo-authored-by: %s <%s>" "$name" "$email" >> "$COMMIT_MSG_FILE"
}

add_coauthor "Copilot" "198982749+Copilot@users.noreply.github.com"
add_coauthor "Claude" "noreply@anthropic.com"
add_coauthor "Cursor" "126759922+cursor@users.noreply.github.com"
add_coauthor "Gemini" "224641728+gemini-cli-robot@users.noreply.github.com"
add_coauthor "Devin" "158243242+devin-ai-integration[bot]@users.noreply.github.com"

printf "\n" >> "$COMMIT_MSG_FILE"

exit 0
